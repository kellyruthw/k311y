# Copy to .env.local and fill in. .env.local is gitignored.

# The WPGraphQL endpoint on the Local site.
# Until WordPress exists, the loaders in lib/queries/ return fixtures and this
# is unused -- see lib/graphql.ts.
WORDPRESS_GRAPHQL_URL=http://k311y-wordpress.local/graphql

# OPTIONAL. The public origin this site is served from, used as metadataBase in
# app/layout.tsx so canonical and og:url resolve to absolute URLs.
#
# This is the front end's own address, never the WordPress one: Yoast's
# canonical points at the WordPress permalink, which is both the wrong host and,
# for case studies and projects, the wrong path. See lib/seo.ts.
#
# Leave it unset and it defaults to https://k311y.com, which is correct for
# production and harmless in dev. Set it only for a staging or preview build
# that needs to canonicalise somewhere else.
# NEXT_PUBLIC_SITE_URL=https://staging.k311y.com

# OPTIONAL. GA4 Measurement ID, e.g. G-ABCD1234EF.
#
# It must be the MEASUREMENT ID, which is the only identifier gtag.js can use.
# GA shows several numbers and the rest look just as official:
#
#   Measurement ID   G-XXXXXXXXXX   this one
#   Property ID      323708029      Admin > Property details
#   Account ID       Admin > Account details
#   Stream ID        beside the Measurement ID, confusingly
#
# Find it in GA: Admin > Data streams > the web stream > top right.
#
# Leave it unset and no tag is rendered at all -- which is what you want in dev
# and on previews, so they cannot report into the production property. The
# component warns in dev if the value is set but is not a Measurement ID.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
